@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<style>

    body {
        background: #fff8f0;
    }

    .login-container {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .login-box {
        width: 100%;
        max-width: 550px;
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .logo-title {
        text-align: center;
        font-size: 32px;
        font-weight: bold;
        color: #5c3d2e;
    }

    .sub-title {
        text-align: center;
        color: gray;
        margin-bottom: 25px;
    }

    .form-control {
        border-radius: 12px;
        height: 45px;
    }

    .btn-login {
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 12px;
        background: #6f4e37;
        color: white;
        font-weight: bold;
        font-size: 17px;
        transition: 0.3s;
    }

        .btn-login:hover {
            background: #5a3f2c;
        }

    .register-link {
        text-align: center;
        margin-top: 20px;
    }

        .register-link a {
            text-decoration: none;
            font-weight: bold;
            color: #6f4e37;
        }

    .cat-icon {
        font-size: 60px;
        text-align: center;
        margin-bottom: 10px;
    }

    label {
        font-weight: 600;
        margin-bottom: 6px;
    }

    .remember-box {
        margin-bottom: 20px;
    }

    .extra-link {
        text-align: center;
        margin-top: 10px;
    }

        .extra-link a {
            color: #6f4e37;
            text-decoration: none;
            font-weight: 500;
        }

            .extra-link a:hover {
                text-decoration: underline;
            }
</style>

<div class="login-container">

    <div class="login-box">
        <div class="logo-title">Nhà Mèo Shop</div>
        <div class="sub-title">Đăng nhập để tiếp tục mua trà sữa</div>
        <form id="account" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <!-- EMAIL -->
            <div class="form-group mb-3">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control" placeholder="Nhập email..." />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- PASSWORD -->
            <div class="form-group mb-3">
                <label asp-for="Input.Password"> Mật khẩu </label>
                <input asp-for="Input.Password" class="form-control" placeholder="Nhập mật khẩu..." />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- REMEMBER -->
            <div class="form-check remember-box">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"> Ghi nhớ đăng nhập </label>
            </div>

            <!-- BUTTON -->
            <button type="submit" class="btn-login"><i class="fa-solid fa-right-to-bracket"></i> Đăng nhập </button>

            <!-- LINK -->
            <div class="register-link"> Chưa có tài khoản?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"> Đăng ký </a>
            </div>
            <div class="extra-link">
                <a id="forgot-password" asp-page="./ForgotPassword"> Quên mật khẩu? </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}