@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Nhà Mèo Shop
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>

        body {
            background-color: #fff8f5;
        }

        /* NAVBAR */
        .navbar-brand {
            min-width: 220px;
            white-space: nowrap;
        }

        .shop-name {
            font-size: 40px;
            font-weight: bold;
            color: white;
            line-height: 1;
            white-space: nowrap;
        }

        .navbar-nav {
            white-space: nowrap;
        }

        .navbar {
            background: linear-gradient(90deg, #4b2e2e, #6f4e37);
            padding: 12px 0;
        }
        /* LOGO */
        .shop-logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-right: 5px;
        }

        /* BRAND */
        .navbar-brand {
            font-size: 22px;
            font-weight: bold;
            color: white !important;
            display: flex;
            align-items: center;
        }

        /* MENU */
        .nav-link {
            color: white !important;
            font-size: 15px;
            font-weight: 500;
            margin-right: 5px;
            transition: 0.3s;
            white-space: nowrap;
        }

            .nav-link:hover {
                color: yellow !important;
                transform: translateY(-2px);
            }

        .menu-icon {
            margin-right: 4px;
        }

        .main-container {
            min-height: 80vh;
        }
        /* DROPDOWN FIX */
        .show-on-hover:hover .dropdown-menu {
            display: block;
            margin-top: 0;
        }

        .dropdown-menu {
            min-width: 220px;
        }

        footer {
            background-color: white;
            padding: 15px 0;
            text-align: center;
        }

        .footer-text {
            color: gray;
            font-size: 14px;
        }

        .user-name {
            color: white;
            font-weight: bold;
            margin-right: 10px;
        }

        .btn-logout {
            border: none;
            background: transparent;
            color: white;
            font-weight: 500;
        }

            .btn-logout:hover {
                color: yellow;
            }
    </style>

</head>

<body>

    <!-- HEADER -->
    <header>

        <nav class="navbar navbar-expand-lg navbar-dark shadow">

            <div class="container-fluid px-5">

                <!-- LOGO -->
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/LoGoGoc1.png"
                         class="shop-logo" />

                    Nhà Mèo Shop

                </a>

                <!-- MOBILE -->
                <button class="navbar-toggler"
                        type="button"
                        data-toggle="collapse"
                        data-target="#navbarMain">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- MENU -->
                <div class="collapse navbar-collapse justify-content-center"
                     id="navbarMain">

                    <ul class="navbar-nav mr-auto">

                        <!-- HOME -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="fa-solid fa-house menu-icon"></i>
                                Trang chủ

                            </a>

                        </li>

                        <!-- PRODUCTS -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Products"
                               asp-action="Index">

                                <i class="fa-solid fa-mug-hot menu-icon"></i>
                                Sản phẩm

                            </a>

                        </li>

                        <!-- CUSTOMER -->
                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Cart"
                                   asp-action="Index">

                                    <i class="fa-solid fa-cart-shopping menu-icon"></i>
                                    Giỏ hàng

                                </a>

                            </li>
                        }

                        <!-- STAFF + ADMIN -->
                        @if (User.IsInRole("Admin")
                   || User.IsInRole("Staff"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="HoaDon"
                                   asp-action="Index">

                                    <i class="fa-solid fa-file-invoice-dollar menu-icon"></i>
                                    Hóa đơn

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="PhieuNhap"
                                   asp-action="Index">

                                    <i class="fa-solid fa-box-open menu-icon"></i>
                                    Phiếu nhập

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="PhieuXuat"
                                   asp-action="Index">

                                    <i class="fa-solid fa-truck menu-icon"></i>
                                    Phiếu xuất

                                </a>

                            </li>
                        }

                        <!-- ADMIN -->
                        @if (User.IsInRole("Admin"))
                        {
                            <!-- DROPDOWN NHÂN VIÊN -->
                            <li class="nav-item dropdown show-on-hover">

                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   id="employeeDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="fa-solid fa-users menu-icon"></i>
                                    Loại nhân viên

                                </a>

                                <ul class="dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Employees"
                                           asp-action="Index">

                                            Tất cả nhân viên

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Employees"
                                           asp-action="Index"
                                           asp-route-loai="PV">

                                            Phục vụ

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Employees"
                                           asp-action="Index"
                                           asp-route-loai="TN">

                                            Thu ngân

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Employees"
                                           asp-action="Index"
                                           asp-route-loai="PC">

                                            Pha chế

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Employees"
                                           asp-action="Index"
                                           asp-route-loai="QL">

                                            Quản lí

                                        </a>
                                    </li>

                                </ul>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="KhachHangs"
                                   asp-action="Index">

                                    <i class="fa-solid fa-layer-group menu-icon"></i>
                                    Khách hàng

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    <i class="fa-solid fa-chart-line menu-icon"></i>
                                    Admin

                                </a>

                            </li>
                        }

                    </ul>

                    <!-- LOGIN -->
                    <ul class="navbar-nav">

                        <partial name="_LoginPartial" />

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- BODY -->
    <div class="container mt-4 main-container">

        <main role="main">

            @RenderBody()

        </main>

    </div>

    <!-- FOOTER -->
    <footer class="border-top">

        <div class="container footer-text">

            © 2026 - Cà Phê & Trà Sữa Nhà Mèo

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts",
        required: false)

</body>

</html>