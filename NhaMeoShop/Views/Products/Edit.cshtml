@model NhaMeoShop.Models.SanPham

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<style>

    body {
        background: #fff8f5;
    }

    .edit-card {
        background: white;
        border-radius: 25px;
        padding: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .page-title {
        font-size: 35px;
        font-weight: bold;
        color: #6f4e37;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        height: 48px;
    }

    textarea.form-control {
        height: 120px;
    }

    .preview-img {
        width: 100%;
        max-height: 320px;
        object-fit: contain;
        border-radius: 15px;
        background: white;
        padding: 10px;
        border: 1px solid #ddd;
    }

    .btn-save {
        background: #6f4e37;
        color: white;
        border-radius: 12px;
        padding: 10px 25px;
        border: none;
        font-weight: bold;
    }

        .btn-save:hover {
            background: #5a3f2c;
            color: white;
        }

    .btn-back {
        border-radius: 12px;
        padding: 10px 25px;
        font-weight: bold;
    }
</style>

<div class="container mt-4">

    <h2 class="page-title mb-4">Chỉnh sửa sản phẩm</h2>

    <div class="edit-card">

        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="MaSP" />
            <div class="row">
                <!-- FORM -->
                <div class="col-md-7">
                    <!-- TÊN -->
                    <div class="mb-3">
                        <label class="fw-bold">Tên sản phẩm</label>
                        <input asp-for="TenSP" class="form-control" />
                        <span asp-validation-for="TenSP" class="text-danger"></span>
                    </div>

                    <!-- GIÁ -->
                    <div class="mb-3">
                        <label class="fw-bold">Giá sản phẩm</label>
                        <input asp-for="DonGiaSP" class="form-control" />
                        <span asp-validation-for="DonGiaSP" class="text-danger"></span>
                    </div>

                    <!-- LOẠI -->
                    <div class="mb-3">
                        <label class="fw-bold">Loại sản phẩm</label>
                        <select asp-for="MaLoaiSP" class="form-select" asp-items="ViewBag.MaLoaiSP"></select>
                        <span asp-validation-for="MaLoaiSP" class="text-danger"></span>
                    </div>

                    <!-- GHI CHÚ -->
                    <div class="mb-3">
                        <label class="fw-bold">Ghi chú</label>
                        <textarea asp-for="GhiChuSP" class="form-control"></textarea>
                        <span asp-validation-for="GhiChuSP" class="text-danger"></span>
                    </div>

                    <!-- UPLOAD -->
                    <div class="mb-4">
                        <label class="fw-bold">Chọn hình mới</label>
                        <input type="file" name="imageFile" class="form-control" />
                    </div>

                    <!-- BUTTON -->
                    <button type="submit" class="btn btn-save">
                        <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi </button>
                    <a asp-action="Index" class="btn btn-secondary btn-back"> Quay lại </a>
                </div>

                <!-- HÌNH -->
                <div class="col-md-5 text-center">
                    <img src="~/images/@Model.HinhAnhSP" class="preview-img" />
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}