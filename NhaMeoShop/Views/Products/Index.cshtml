@model IEnumerable<NhaMeoShop.Models.SanPham>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DonGiaSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HinhAnhSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GhiChuSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoaiSanPham)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TenSP)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DonGiaSP)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HinhAnhSP)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GhiChuSP)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LoaiSanPham.MaLoaiSP)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaSP">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaSP">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaSP">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
