@model NhaMeoShop.Models.SanPham

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<style>

    body {
        background: #fff8f5;
    }

    .details-card {
        background: white;
        border-radius: 25px;
        padding: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .product-img {
        width: 100%;
        height: 420px;
        object-fit: contain;
        background: white;
        border-radius: 20px;
        padding: 15px;
    }

    .product-name {
        font-size: 36px;
        font-weight: bold;
        color: #6f4e37;
    }

    .product-price {
        color: #dc3545;
        font-size: 32px;
        font-weight: bold;
    }

    .product-note {
        font-size: 18px;
        color: #666;
        line-height: 1.7;
    }

    .info-box {
        background: #fff3e6;
        padding: 12px 18px;
        border-radius: 12px;
        margin-bottom: 15px;
        font-size: 17px;
    }

    .btn-custom {
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: bold;
    }
</style>

<div class="container mt-4">

    <div class="details-card">
        <div class="row align-items-center">
            <!-- HÌNH -->
            <div class="col-md-5 text-center">
                <img src="~/images/@Model.HinhAnhSP" class="product-img" />
            </div>

            <!-- THÔNG TIN -->
            <div class="col-md-7">
                <div class="product-name mb-3">@Model.TenSP</div>
                <div class="product-price mb-4">@Model.DonGiaSP.ToString("N0") đ</div>
                <div class="info-box"><strong>Loại sản phẩm: </strong>@Model.LoaiSanPham.TenLoaiSP</div>
                <div class="info-box"><strong>Mã sản phẩm: </strong>@Model.MaSP</div>
                <div class="product-note mb-4">@Model.GhiChuSP</div>

                <!-- CUSTOMER -->
                @if (User.IsInRole("Customer"))
                {
                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.MaSP" class="btn btn-success btn-custom">
                        <i class="fa-solid fa-cart-plus"></i>Thêm vào giỏ hàng</a>
                }

                <!-- ADMIN -->
                @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.MaSP" class="btn btn-warning btn-custom text-dark">
                        <i class="fa-solid fa-pen"></i>Chỉnh sửa</a>
                }

                <a asp-action="Index" class="btn btn-secondary btn-custom">
                    <i class="fa-solid fa-arrow-left"></i>Quay lại</a>
            </div>
        </div>
    </div>
</div>