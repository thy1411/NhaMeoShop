@model List<NhaMeoShop.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
}

<style>

    body {
        background: #fff8f5;
    }

    .cart-title {
        font-size: 35px;
        font-weight: bold;
        color: #6f4e37;
    }

    .cart-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .product-img {
        width: 90px;
        height: 90px;
        object-fit: contain;
    }

    .total-box {
        font-size: 28px;
        font-weight: bold;
        color: #dc3545;
    }

    .btn-checkout {
        background: #6f4e37;
        color: white;
        border-radius: 12px;
        padding: 12px 25px;
        font-size: 18px;
        border: none;
        transition: 0.3s;
    }

        .btn-checkout:hover {
            background: #5a3f2c;
            color: white;
        }

    .btn-delete {
        border-radius: 10px;
    }

    #successAlert {
        border-radius: 12px;
        font-size: 17px;
    }
</style>

<div class="container mt-4">

    <h2 class="cart-title mb-4">

        🛒 Giỏ hàng Nhà Mèo

    </h2>

    @if (TempData["msg"] != null)
    {
        <div id="successAlert"
             class="alert alert-success shadow-sm">

            @TempData["msg"]

        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">

            Chưa có sản phẩm nào trong giỏ hàng

        </div>
    }
    else
    {
        <div class="cart-card">

            <table class="table align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>Hình</th>

                        <th>Sản phẩm</th>

                        <th>Giá</th>

                        <th>Số lượng</th>

                        <th>Thành tiền</th>

                        <th></th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- HÌNH -->
                            <td>

                                <img src="~/images/@item.SanPham.HinhAnhSP"
                                     class="product-img" />

                            </td>

                            <!-- TÊN -->
                            <td>

                                <strong>

                                    @item.SanPham.TenSP

                                </strong>

                            </td>

                            <!-- GIÁ -->
                            <td>

                                @item.SanPham.DonGiaSP.ToString("N0") đ

                            </td>

                            <!-- SỐ LƯỢNG -->
                            <td>

                                @item.SoLuong

                            </td>

                            <!-- THÀNH TIỀN -->
                            <td class="text-danger fw-bold">

                                @((item.SoLuong * item.SanPham.DonGiaSP).ToString("N0")) đ

                            </td>

                            <!-- XÓA -->
                            <td>

                                <a asp-action="Remove"
                                   asp-route-id="@item.SanPham.MaSP"
                                   class="btn btn-danger btn-delete">

                                    <i class="fa-solid fa-trash"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- TỔNG -->
            <div class="d-flex
                        justify-content-between
                        align-items-center
                        mt-4">

                <div class="total-box">

                    Tổng tiền:

                    @Model.Sum(x => x.SoLuong * x.SanPham.DonGiaSP).ToString("N0") đ

                </div>

                <a asp-action="Checkout"
                   class="btn btn-checkout">

                    <i class="fa-solid fa-credit-card"></i>

                    Thanh toán

                </a>

            </div>

        </div>
    }

</div>

<script>

    setTimeout(function () {

        var alertBox =
            document.getElementById("successAlert");

        if (alertBox) {

            alertBox.style.transition =
                "0.5s";

            alertBox.style.opacity =
                "0";

            setTimeout(function () {

                alertBox.style.display =
                    "none";

            }, 500);
        }

    }, 2000);

</script>