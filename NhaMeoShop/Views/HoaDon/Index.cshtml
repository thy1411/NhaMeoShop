@model IEnumerable<NhaMeoShop.Models.HoaDon>

@{
    ViewData["Title"] = "Danh sách hóa đơn";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">
            Danh sách hóa đơn
        </h2>

        <a asp-action="Create" class="btn btn-success">
            + Tạo hóa đơn
        </a>
    </div>

    @if (TempData["msg"] != null)
    {
        <div class="alert alert-success">
            @TempData["msg"]
        </div>
    }

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark text-center">
            <tr>
                <th>Mã HĐ</th>
                <th>Ngày lập</th>
                <th>Khách hàng</th>
                <th>Tổng tiền</th>
                <th>Thanh toán</th>
                <th>Trạng thái</th>
                <th width="220">Chức năng</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    double tongTien = 0;

                    if (item.ChiTietHoaDons != null)
                    {
                        tongTien = item.ChiTietHoaDons
                        .Sum(x => x.SLBan * x.DGBan);
                    }

                    <tr>

                        <td class="fw-bold text-primary">
                            @item.SoHD
                        </td>

                        <td>
                            @item.NgayLap.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @item.MaKH
                        </td>

                        <td class="text-danger fw-bold">
                            @tongTien.ToString("N0") đ
                        </td>

                        <td>
                            @(item.HinhThucTT ? "Đã thanh toán" : "Chưa thanh toán")
                        </td>

                        <td>
                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success">
                                    Hoàn thành
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Chờ xử lý
                                </span>
                            }
                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@item.SoHD"
                               class="btn btn-info btn-sm">
                                Chi tiết
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.SoHD"
                               class="btn btn-warning btn-sm">
                                Sửa
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.SoHD"
                               class="btn btn-danger btn-sm">
                                Xóa
                            </a>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-danger">
                        Chưa có hóa đơn nào
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>