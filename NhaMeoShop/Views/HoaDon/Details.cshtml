@model NhaMeoShop.Models.HoaDon

@{
    ViewData["Title"] = "Chi tiết hóa đơn";

    double tongTien = 0;

    if (Model.ChiTietHoaDons != null)
    {
        tongTien = Model.ChiTietHoaDons
        .Sum(x => x.SLBan * x.DGBan);
    }
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>
                Chi tiết hóa đơn
            </h3>
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-6">
                    <p>
                        <strong>Mã hóa đơn:</strong>
                        @Model.SoHD
                    </p>

                    <p>
                        <strong>Ngày lập:</strong>
                        @Model.NgayLap.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p>
                        <strong>Khách hàng:</strong>
                        @Model.MaKH
                    </p>

                    <p>
                        <strong>Nhân viên:</strong>
                        @(Model.MaNV ?? "Chưa cập nhật")
                    </p>
                </div>

                <div class="col-md-6">

                    <p>
                        <strong>Phụ phí:</strong>
                        @Model.PhuPhi.ToString("N0") đ
                    </p>

                    <p>
                        <strong>Khuyến mãi:</strong>
                        @Model.KhuyenMai.ToString("N0") đ
                    </p>

                    <p>
                        <strong>Thanh toán:</strong>

                        @if (Model.HinhThucTT)
                        {
                            <span class="badge bg-success">
                                Đã thanh toán
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Chưa thanh toán
                            </span>
                        }
                    </p>

                    <p>
                        <strong>Trạng thái:</strong>

                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success">
                                Hoàn thành
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Chờ xử lý
                            </span>
                        }
                    </p>

                </div>

            </div>

            <hr />

            <h4 class="mb-3">
                Danh sách sản phẩm
            </h4>

            <table class="table table-bordered table-hover">

                <thead class="table-dark text-center">
                    <tr>
                        <th>Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.ChiTietHoaDons != null &&
                  Model.ChiTietHoaDons.Any())
                    {
                        @foreach (var item in Model.ChiTietHoaDons)
                        {
                            double thanhTien = item.SLBan * item.DGBan;

                            <tr>

                                <td>
                                    @item.MaSP
                                </td>

                                <td>
                                    @item.SanPham.TenSP
                                </td>

                                <td class="text-center">
                                    @item.SLBan
                                </td>

                                <td>
                                    @item.DGBan.ToString("N0") đ
                                </td>

                                <td class="text-danger fw-bold">
                                    @thanhTien.ToString("N0") đ
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-danger">
                                Không có sản phẩm nào
                            </td>
                        </tr>
                    }

                </tbody>

                <tfoot>

                    <tr>

                        <td colspan="4" class="text-end fw-bold">
                            Tổng tiền:
                        </td>

                        <td class="text-danger fw-bold fs-5">
                            @tongTien.ToString("N0") đ
                        </td>

                    </tr>

                </tfoot>

            </table>

            <div class="mt-3">

                <p>
                    <strong>Ghi chú:</strong>
                    @(string.IsNullOrEmpty(Model.GhiChuHD)
                        ? "Không có ghi chú"
                        : Model.GhiChuHD)
                </p>

            </div>

        </div>

        <div class="card-footer">

            <a asp-action="Edit"
               asp-route-id="@Model.SoHD"
               class="btn btn-warning">
                Sửa
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>

        </div>

    </div>

</div>