@model NhaMeoShop.Models.HoaDon

@{
    ViewData["Title"] = "Cập nhật hóa đơn";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">
            <h3 class="mb-0">
                Cập nhật hóa đơn
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <input type="hidden" asp-for="SoHD" />

                <div class="row">

                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="NgayLap"
                                   class="form-label fw-bold">
                                Ngày lập
                            </label>

                            <input asp-for="NgayLap"
                                   class="form-control" />

                            <span asp-validation-for="NgayLap"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhuPhi"
                                   class="form-label fw-bold">
                                Phụ phí
                            </label>

                            <input asp-for="PhuPhi"
                                   class="form-control" />

                            <span asp-validation-for="PhuPhi"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="KhuyenMai"
                                   class="form-label fw-bold">
                                Khuyến mãi
                            </label>

                            <input asp-for="KhuyenMai"
                                   class="form-control" />

                            <span asp-validation-for="KhuyenMai"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GhiChuHD"
                                   class="form-label fw-bold">
                                Ghi chú
                            </label>

                            <textarea asp-for="GhiChuHD"
                                      class="form-control"
                                      rows="3">
                            </textarea>

                            <span asp-validation-for="GhiChuHD"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="MaKH"
                                   class="form-label fw-bold">
                                Mã khách hàng
                            </label>

                            <input asp-for="MaKH"
                                   class="form-control" />

                            <span asp-validation-for="MaKH"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaNV"
                                   class="form-label fw-bold">
                                Mã nhân viên
                            </label>

                            <input asp-for="MaNV"
                                   class="form-control" />

                            <span asp-validation-for="MaNV"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-check mb-3">

                            <input class="form-check-input"
                                   asp-for="HinhThuc" />

                            <label class="form-check-label fw-bold"
                                   asp-for="HinhThuc">
                                Hình thức giao hàng
                            </label>

                        </div>

                        <div class="form-check mb-3">

                            <input class="form-check-input"
                                   asp-for="HinhThucTT" />

                            <label class="form-check-label fw-bold"
                                   asp-for="HinhThucTT">
                                Đã thanh toán
                            </label>

                        </div>

                        <div class="form-check mb-3">

                            <input class="form-check-input"
                                   asp-for="TrangThai" />

                            <label class="form-check-label fw-bold"
                                   asp-for="TrangThai">
                                Hoàn thành đơn hàng
                            </label>

                        </div>

                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Lưu thay đổi
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}