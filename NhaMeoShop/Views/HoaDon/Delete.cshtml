@model NhaMeoShop.Models.HoaDon

@{
    ViewData["Title"] = "Xóa hóa đơn";

    double tongTien = 0;

    if (Model.ChiTietHoaDons != null)
    {
        tongTien = Model.ChiTietHoaDons
        .Sum(x => x.SLBan * x.DGBan);
    }
}

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                Xóa hóa đơn
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                Bạn có chắc muốn xóa hóa đơn này không?
            </div>

            <div class="row">

                <div class="col-md-6">

                    <p>
                        <strong>Mã hóa đơn:</strong>
                        @Model.SoHD
                    </p>

                    <p>
                        <strong>Ngày lập:</strong>
                        @Model.NgayLap.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p>
                        <strong>Mã khách hàng:</strong>
                        @Model.MaKH
                    </p>

                    <p>
                        <strong>Mã nhân viên:</strong>
                        @(Model.MaNV ?? "Chưa cập nhật")
                    </p>

                </div>

                <div class="col-md-6">

                    <p>
                        <strong>Phụ phí:</strong>
                        @Model.PhuPhi.ToString("N0") đ
                    </p>

                    <p>
                        <strong>Khuyến mãi:</strong>
                        @Model.KhuyenMai.ToString("N0") đ
                    </p>

                    <p>
                        <strong>Tổng tiền:</strong>

                        <span class="text-danger fw-bold">
                            @tongTien.ToString("N0") đ
                        </span>
                    </p>

                    <p>
                        <strong>Thanh toán:</strong>

                        @if (Model.HinhThucTT)
                        {
                            <span class="badge bg-success">
                                Đã thanh toán
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Chưa thanh toán
                            </span>
                        }
                    </p>

                </div>

            </div>

            <hr />

            <h5 class="mb-3">
                Danh sách sản phẩm
            </h5>

            <table class="table table-bordered table-hover">

                <thead class="table-dark text-center">
                    <tr>
                        <th>Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.ChiTietHoaDons != null &&
                  Model.ChiTietHoaDons.Any())
                    {
                        @foreach (var item in Model.ChiTietHoaDons)
                        {
                            <tr>

                                <td>
                                    @item.MaSP
                                </td>

                                <td>
                                    @item.SanPham.TenSP
                                </td>

                                <td class="text-center">
                                    @item.SLBan
                                </td>

                                <td>
                                    @item.DGBan.ToString("N0") đ
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4"
                                class="text-center text-danger">
                                Không có dữ liệu sản phẩm
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

            <div class="mt-3">

                <p>
                    <strong>Ghi chú:</strong>
                    @(string.IsNullOrEmpty(Model.GhiChuHD)
                        ? "Không có ghi chú"
                        : Model.GhiChuHD)
                </p>

            </div>

            <hr />

            <form asp-action="Delete">

                <input type="hidden" asp-for="SoHD" />

                <button type="submit"
                        class="btn btn-danger">
                    Xác nhận xóa
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </form>

        </div>

    </div>

</div>