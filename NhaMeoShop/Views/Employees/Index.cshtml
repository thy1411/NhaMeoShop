@model IEnumerable<NhaMeoShop.Models.NhanVien>

@{
    ViewData["Title"] = "Nhân viên";
}

<style>

    body {
        background: #fff8f5;
    }

    .page-title {
        font-size: 34px;
        font-weight: bold;
        color: #5c3d2e;
    }

    .employee-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        transition: 0.3s;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        background: white;
    }

        .employee-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

    .employee-avatar {
        width: 100%;
        height: 220px;
        object-fit: cover;
        background: #f8f8f8;
    }

    .employee-name {
        font-size: 22px;
        font-weight: bold;
        color: #5c3d2e;
    }

    .employee-role {
        display: inline-block;
        background: #6f4e37;
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .employee-info {
        color: #666;
        margin-bottom: 6px;
        font-size: 15px;
    }

    .btn-action {
        border-radius: 10px;
        margin: 2px;
        width: 42px;
        height: 42px;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .btn-add {
        background: #198754;
        color: white;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 600;
    }

        .btn-add:hover {
            background: #157347;
            color: white;
        }

    .filter-title {
        color: #6f4e37;
        font-weight: bold;
        margin-bottom: 20px;
    }
</style>

<div class="container mt-4">

    <!-- TITLE -->
    <div class="top-bar">

        <div>

            @if (ViewBag.LoaiDangChon != null)
            {
                <h2 class="page-title">
                    Nhân viên - @ViewBag.LoaiDangChon 👨‍💼
                </h2>
            }
            else
            {
                <h2 class="page-title">
                    Tất cả nhân viên 👨‍💼
                </h2>
            }

        </div>

        <a asp-action="Create"
           class="btn btn-add">

            <i class="fa-solid fa-plus"></i>
            Thêm nhân viên

        </a>

    </div>

    <!-- LIST -->
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card employee-card h-100">

                    <!-- AVATAR -->
                    <img src="https://cdn-icons-png.flaticon.com/512/4140/4140048.png"
                         class="employee-avatar" />

                    <!-- BODY -->
                    <div class="card-body">

                        <!-- TÊN -->
                        <div class="employee-name mb-2">

                            @item.TenNV

                        </div>

                        <!-- LOẠI -->
                        <div class="employee-role">

                            @item.LoaiNhanVien?.TenLoaiNV

                        </div>

                        <!-- GIỚI TÍNH -->
                        <div class="employee-info">

                            <i class="fa-solid fa-venus-mars"></i>
                            @item.PhaiNV

                        </div>

                        <!-- NGÀY SINH -->
                        <div class="employee-info">

                            <i class="fa-solid fa-calendar"></i>
                            @item.NgaySinhNV.ToString("dd/MM/yyyy")

                        </div>

                        <!-- SĐT -->
                        <div class="employee-info">

                            <i class="fa-solid fa-phone"></i>
                            @item.SoDTNV

                        </div>

                        <!-- ĐỊA CHỈ -->
                        <div class="employee-info">

                            <i class="fa-solid fa-location-dot"></i>
                            @item.DiaChiNV

                        </div>

                        <!-- NGÂN HÀNG -->
                        <div class="employee-info">

                            <i class="fa-solid fa-building-columns"></i>
                            @item.TenNganHangNV

                        </div>

                        <!-- BUTTON -->
                        <div class="mt-4 text-center">

                            <a asp-action="Edit"
                               asp-route-id="@item.MaNV"
                               class="btn btn-warning btn-action">

                                <i class="fa-solid fa-pen"></i>

                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.MaNV"
                               class="btn btn-info text-white btn-action">

                                <i class="fa-solid fa-eye"></i>

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.MaNV"
                               class="btn btn-danger btn-action">

                                <i class="fa-solid fa-trash"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>