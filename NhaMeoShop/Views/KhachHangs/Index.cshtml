@model IEnumerable<NhaMeoShop.Models.KhachHang>

@{
    ViewData["Title"] = "Danh sách khách hàng";
}

<style>

    body {
        background: #fdf6f0;
    }

    .page-title {
        color: #6f4e37;
        font-size: 42px;
        font-weight: bold;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .btn-create {
        background: #6f4e37;
        color: white;
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: bold;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-create:hover {
            background: #5a3f2c;
            color: white;
            transform: translateY(-2px);
        }

    .table-container {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }

    .table {
        margin-bottom: 0;
    }

        .table thead {
            background: linear-gradient(90deg, #4b2e2e, #6f4e37);
            color: white;
        }

        .table th {
            text-align: center;
            vertical-align: middle;
            padding: 15px;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
            text-align: center;
            padding: 14px;
        }

        .table tbody tr:hover {
            background: #fff3eb;
            transition: 0.2s;
        }

    .badge-role {
        background: #f3e5d8;
        color: #6f4e37;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: bold;
    }

    .btn-action {
        border: none;
        border-radius: 10px;
        padding: 8px 12px;
        color: white;
        margin: 2px;
        transition: 0.2s;
    }

        .btn-action:hover {
            transform: scale(1.05);
            color: white;
        }

    .btn-edit {
        background: #0d6efd;
    }

    .btn-detail {
        background: #198754;
    }

    .btn-delete {
        background: #dc3545;
    }

    .empty-box {
        padding: 30px;
        text-align: center;
        color: gray;
        font-size: 18px;
    }
</style>

<div class="container mt-4">

    <!-- TITLE -->
    <div class="top-bar">

        <h1 class="page-title">
            👥 Danh sách khách hàng
        </h1>

        <a asp-action="Create"
           class="btn-create">

            <i class="fa-solid fa-plus"></i>
            Thêm khách hàng

        </a>

    </div>

    <!-- TABLE -->
    <div class="table-container">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>Tên khách hàng</th>

                    <th>Ngày sinh</th>

                    <th>SĐT</th>

                    <th>Ngày đăng ký</th>

                    <th>Email</th>

                    <th>Ghi chú</th>

                    <th>Loại KH</th>

                    <th width="220">
                        Chức năng
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @item.TenKH
                                </strong>
                            </td>

                            <td>
                                @item.NgaySinhKH.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @item.SoDTKH
                            </td>

                            <td>
                                @item.NgayDKTV.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @item.Email
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(item.GhiChuKH)
                                    ? "Không có"
                                    : item.GhiChuKH)
                            </td>

                            <td>

                                <span class="badge-role">
                                    @item.MaLoaiKH
                                </span>

                            </td>

                            <td>

                                <!-- EDIT -->
                                <a asp-action="Edit"
                                   asp-route-id="@item.MaKH"
                                   class="btn-action btn-edit">

                                    <i class="fa-solid fa-pen-to-square"></i>

                                </a>

                                <!-- DETAILS -->
                                <a asp-action="Details"
                                   asp-route-id="@item.MaKH"
                                   class="btn-action btn-detail">

                                    <i class="fa-solid fa-eye"></i>

                                </a>

                                <!-- DELETE -->
                                <a asp-action="Delete"
                                   asp-route-id="@item.MaKH"
                                   class="btn-action btn-delete">

                                    <i class="fa-solid fa-trash"></i>

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8"
                            class="empty-box">

                            Chưa có khách hàng nào 🐾

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>