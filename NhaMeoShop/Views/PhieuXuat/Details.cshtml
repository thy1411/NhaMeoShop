@model NhaMeoShop.Models.PhieuXuat

@{
    ViewData["Title"] = "Chi tiết phiếu xuất";
}

<style>

    body {
        background: #f8f5f0;
    }

    .details-card {
        background: white;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .page-title {
        font-size: 32px;
        font-weight: bold;
        color: #6f4e37;
        margin-bottom: 25px;
    }

    .info-row {
        padding: 14px 0;
        border-bottom: 1px solid #f1f1f1;
    }

    .info-label {
        font-weight: bold;
        color: #5c3d2e;
    }

    .info-value {
        color: #555;
    }

    .employee-badge {
        background: #f3e5d8;
        color: #6f4e37;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 600;
        display: inline-block;
    }

    .btn-custom {
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 500;
    }

    .btn-edit {
        background: #6f4e37;
        color: white;
        border: none;
    }

        .btn-edit:hover {
            background: #5c3d2e;
            color: white;
        }

    .btn-back {
        background: #ddd;
        color: black;
        border: none;
    }

        .btn-back:hover {
            background: #bbb;
        }
</style>

<div class="container mt-4">

    <div class="details-card">

        <div class="page-title">
            <i class="fa-solid fa-file-export"></i>
            Chi tiết phiếu xuất
        </div>

        <div class="row info-row">

            <div class="col-md-3 info-label">
                Số phiếu xuất
            </div>

            <div class="col-md-9 info-value">
                @Model.SoPX
            </div>

        </div>

        <div class="row info-row">

            <div class="col-md-3 info-label">
                Ngày xuất
            </div>

            <div class="col-md-9 info-value">
                @Model.NgayXuat.ToString("dd/MM/yyyy")
            </div>

        </div>

        <div class="row info-row">

            <div class="col-md-3 info-label">
                Nhân viên xuất hàng
            </div>

            <div class="col-md-9 info-value">

                @if (string.IsNullOrEmpty(Model.XuatHang))
                {
                    <span>
                        Chưa cập nhật
                    </span>
                }
                else
                {
                    <span class="employee-badge">
                        @Model.XuatHang
                    </span>
                }

            </div>

        </div>

        <div class="row info-row">

            <div class="col-md-3 info-label">
                Ghi chú
            </div>

            <div class="col-md-9 info-value">

                @(string.IsNullOrEmpty(Model.GhiChuPX)
                    ? "Không có ghi chú"
                    : Model.GhiChuPX)

            </div>

        </div>
        <h4 class="mt-4">
            Chi tiết nguyên liệu xuất
        </h4>

        <table class="table table-bordered">

            <thead>

                <tr>
                    <th>Mã NL</th>
                    <th>Tên NL</th>
                    <th>Kho pha chế</th>
                    <th>Số lượng</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var ct in ViewBag.CTPX)
                {
                    <tr>

                        <td>@ct.MaNL</td>

                        <td>@ct.KhoTong?.TenNL</td>

                        <td>@ct.MaKhoPC</td>

                        <td>@ct.SLXuat</td>

                    </tr>
                }

            </tbody>

        </table>

        <div class="mt-4">

            <a asp-action="Edit"
               asp-route-id="@Model.SoPX"
               class="btn btn-edit btn-custom">

                <i class="fa-solid fa-pen-to-square"></i>
                Sửa

            </a>

            <a asp-action="Index"
               class="btn btn-back btn-custom">

                <i class="fa-solid fa-arrow-left"></i>
                Quay lại

            </a>

        </div>

    </div>

</div>