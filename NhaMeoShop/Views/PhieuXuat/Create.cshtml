@model NhaMeoShop.Models.PhieuXuat

@{
    ViewData["Title"] = "Thêm phiếu xuất";
}

<style>

    body {
        background: #f8f5f0;
    }

    .create-card {
        background: white;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .page-title {
        font-size: 32px;
        font-weight: bold;
        color: #6f4e37;
        margin-bottom: 25px;
    }

    .form-label {
        font-weight: 600;
        color: #5c3d2e;
    }

    .form-control,
    textarea {
        border-radius: 10px;
        padding: 10px;
        border: 1px solid #d6c3b8;
    }

    select.form-control {
        height: 35px !important;
        font-size: 16px;
        padding: 0;
        padding-right: 22px;
    }

    .btn-custom {
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 500;
        transition: .3s;
    }

    .btn-save {
        background: #6f4e37;
        color: white;
        border: none;
    }

    .btn-back {
        background: #ddd;
        color: black;
        border: none;
    }

    .table thead {
        background: #6f4e37;
        color: white;
    }
</style>

<div class="container mt-4">

    <div class="create-card">

        <div class="page-title">
            <i class="fa-solid fa-file-circle-plus"></i>
            Thêm phiếu xuất
        </div>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row">

                <!-- SỐ PHIẾU -->
                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Số phiếu xuất
                    </label>

                    <input asp-for="SoPX"
                           class="form-control"
                           value="@ViewBag.SoPX"
                           readonly />

                </div>

                <!-- NGÀY XUẤT -->
                <div class="col-md-6 mb-3">

                    <label asp-for="NgayXuat"
                           class="form-label">
                        Ngày xuất
                    </label>

                    <input asp-for="NgayXuat"
                           type="date"
                           class="form-control" />

                </div>

                <!-- NHÂN VIÊN -->
                <div class="col-md-6 mb-3">

                    <label asp-for="XuatHang"
                           class="form-label">

                        Nhân viên xuất hàng

                    </label>

                    <select asp-for="XuatHang"
                            class="form-control">

                        <option value="">
                            -- Chọn nhân viên --
                        </option>

                        @foreach (var nv in ViewBag.NhanVienQK)
                        {
                            <option value="@($"{nv.MaNV} - {nv.TenNV}")">
                                @nv.MaNV - @nv.TenNV
                            </option>
                        }

                    </select>

                    <span asp-validation-for="XuatHang"
                          class="text-danger"></span>

                </div>

                <!-- GHI CHÚ -->
                <div class="col-md-12 mb-3">

                    <label asp-for="GhiChuPX"
                           class="form-label">
                        Ghi chú
                    </label>

                    <textarea asp-for="GhiChuPX"
                              rows="3"
                              class="form-control"></textarea>

                </div>

            </div>

            <hr />

            <h5>
                Danh sách nguyên liệu xuất
            </h5>

            <table class="table table-bordered"
                   id="tblChiTiet">

                <thead>
                    <tr>
                        <th>Mã nguyên liệu</th>
                        <th>Còn trong kho</th>
                        <th>Số lượng xuất</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>

                        <td>
                            <select name="MaNL[]"
                                    class="form-control nl-select">

                                @foreach (var nl in ViewBag.NL)
                                {
                                    <option value="@nl.MaNL"
                                            data-ton="@nl.SoLuongTon">

                                        @nl.MaNL - @nl.TenNL

                                    </option>
                                }

                            </select>
                        </td>

                        <td>

                            <input type="text"
                                   class="form-control tonkho"
                                   readonly />

                        </td>

                        <td>

                            <input name="SoLuong[]"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   required />

                        </td>

                        <td>

                            <button type="button"
                                    class="form-control btn-danger btn-remove">

                                X

                            </button>

                        </td>

                    </tr>

                </tbody>

            </table>

            <button type="button"
                    id="addRow"
                    class="btn btn-success">

                + Thêm dòng

            </button>

            <div class="mt-4">

                <button type="submit"
                        class="btn btn-save btn-custom">

                    <i class="fa-solid fa-floppy-disk"></i>
                    Lưu phiếu xuất

                </button>

                <a asp-action="Index"
                   class="btn btn-back btn-custom">

                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại

                </a>

            </div>

        </form>

    </div>

</div>

<script>

    function updateRow(row) {
        let select = row.querySelector('.nl-select');

        let ton = row.querySelector('.tonkho');

        let opt = select.options[select.selectedIndex];

        ton.value = opt.getAttribute('data-ton');
    }

    document.querySelectorAll("#tblChiTiet tbody tr")
        .forEach(updateRow);

    document.addEventListener("change", function (e) {
        if (e.target.classList.contains("nl-select")) {
            updateRow(e.target.closest("tr"));
        }
    });

    document.getElementById("addRow").onclick = function () {
        let row =
            document.querySelector("#tblChiTiet tbody tr");

        let clone =
            row.cloneNode(true);

        clone.querySelectorAll("input").forEach(x => {
            if (!x.classList.contains("tennl") &&
                !x.classList.contains("tonkho")) {
                x.value = "";
            }
        });

        document
            .querySelector("#tblChiTiet tbody")
            .appendChild(clone);

        updateRow(clone);
    };

    document.addEventListener("click", function (e) {
        if (e.target.classList.contains("btn-remove")) {
            let rows =
                document.querySelectorAll("#tblChiTiet tbody tr");

            if (rows.length > 1) {
                e.target.closest("tr").remove();
            }
        }
    });

</script>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}