@model IEnumerable<NhaMeoShop.Models.PhieuXuat>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NgayXuat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.XuatHang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GhiChuPX)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NgayXuat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.XuatHang)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GhiChuPX)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SoPX">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SoPX">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SoPX">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
