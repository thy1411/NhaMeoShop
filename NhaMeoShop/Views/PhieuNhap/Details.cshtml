@model NhaMeoShop.Models.PhieuNhap

@{
    ViewData["Title"] = "Chi tiết phiếu nhập";
}

<style>

    body {
        background: #fff8f5;
    }

    .details-container {
        background: white;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .page-title {
        font-size: 34px;
        font-weight: bold;
        color: #6f4e37;
        margin-bottom: 25px;
    }

    .section-title {
        font-size: 24px;
        font-weight: 600;
        color: #5c3d2e;
        margin-bottom: 20px;
    }

    .info-row {
        padding: 14px 0;
        border-bottom: 1px solid #f1e4dc;
    }

    .info-label {
        font-weight: bold;
        color: #6f4e37;
    }

    .info-value {
        color: #444;
    }

    .delivery-badge {
        background: #d1e7dd;
        color: #0f5132;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 600;
    }

    .btn-custom {
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 500;
        transition: 0.3s;
    }

    .btn-edit {
        background: #6f4e37;
        color: white;
        border: none;
    }

        .btn-edit:hover {
            background: #5c3d2e;
            color: white;
            transform: translateY(-2px);
        }

    .btn-back {
        background: #e9ecef;
        color: #333;
        border: none;
    }

        .btn-back:hover {
            background: #d6d9dc;
            color: black;
        }
</style>

<div class="container mt-4">

    <div class="details-container">

        <div class="page-title">
            📋 Chi tiết phiếu nhập
        </div>

        <div class="section-title">
            Thông tin phiếu nhập
        </div>

        <!-- SỐ PHIẾU NHẬP -->
        <div class="row info-row">

            <div class="col-md-3 info-label">
                Số phiếu nhập
            </div>

            <div class="col-md-9 info-value">
                @Model.SoPN
            </div>

        </div>

        <!-- NGÀY NHẬP -->
        <div class="row info-row">

            <div class="col-md-3 info-label">
                Ngày nhập
            </div>

            <div class="col-md-9 info-value">
                @Model.NgayNhap.ToString("dd/MM/yyyy")
            </div>

        </div>

        <!-- NGƯỜI GIAO HÀNG -->
        <div class="row info-row">

            <div class="col-md-3 info-label">
                Người giao hàng
            </div>

            <div class="col-md-9 info-value">

                @if (!string.IsNullOrEmpty(Model.GiaoHang))
                {
                    <span class="delivery-badge">
                        @Model.GiaoHang
                    </span>
                }
                else
                {
                    <span>
                        Không có thông tin
                    </span>
                }

            </div>

        </div>

        <!-- GHI CHÚ -->
        <div class="row info-row">

            <div class="col-md-3 info-label">
                Ghi chú
            </div>

            <div class="col-md-9 info-value">

                @(string.IsNullOrEmpty(Model.GhiChuPN)
                    ? "Không có ghi chú"
                    : Model.GhiChuPN)

            </div>

        </div>

        <!-- MÃ NHÂN VIÊN -->
        <div class="row info-row">

            <div class="col-md-3 info-label">
                Mã nhân viên
            </div>

            <div class="col-md-9 info-value">
                @Model.MaNV
            </div>

        </div>

        <!-- MÃ NHÀ CUNG CẤP -->
        <div class="row info-row">

            <div class="col-md-3 info-label">
                Mã nhà cung cấp
            </div>

            <div class="col-md-9 info-value">
                @Model.MaNCC
            </div>

        </div>
        <!-- CHI TIẾT NGUYÊN LIỆU -->
        <div class="section-title mt-4">
            Danh sách nguyên liệu nhập
        </div>

        @{
            var chiTiets = ViewBag.ChiTiet as List<NhaMeoShop.Models.ChiTietPhieuNhap>;
        }

        @if (chiTiets != null && chiTiets.Any())
        {
            <div class="table-responsive">

                <table class="table table-bordered mt-3">

                    <thead style="background:#6f4e37;color:white;">

                        <tr>
                            <th>Mã NL</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var ct in chiTiets)
                        {
                            <tr>

                                <td>@ct.MaNL</td>

                                <td>@ct.SLNhap</td>

                                <td>
                                    @ct.DGNhap.ToString("N0") đ
                                </td>

                                <td>
                                    @((ct.SLNhap * ct.DGNhap).ToString("N0")) đ
                                </td>

                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr style="font-weight:bold;background:#fff3e6;">

                            <td colspan="3" class="text-end">
                                Tổng tiền
                            </td>

                            <td>
                                @chiTiets.Sum(x => x.SLNhap * x.DGNhap).ToString("N0") đ
                            </td>

                        </tr>

                    </tfoot>

                </table>

            </div>
        }
        else
        {
            <div class="alert alert-warning mt-3">
                Chưa có nguyên liệu nào trong phiếu nhập.
            </div>
        }

        <!-- BUTTON -->
        <div class="mt-4">

            <a asp-action="Edit"
               asp-route-id="@Model.SoPN"
               class="btn btn-custom btn-edit">

                <i class="fa-solid fa-pen-to-square"></i>
                Chỉnh sửa

            </a>

            <a asp-action="Index"
               class="btn btn-custom btn-back">

                <i class="fa-solid fa-arrow-left"></i>
                Quay lại

            </a>

        </div>

    </div>

</div>