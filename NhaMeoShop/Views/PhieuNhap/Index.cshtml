@model IEnumerable<NhaMeoShop.Models.PhieuNhap>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NgayNhap)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GiaoHang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GhiChuPN)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaNV)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaNCC)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NgayNhap)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GiaoHang)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GhiChuPN)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaNV)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaNCC)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SoPN">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SoPN">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SoPN">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
