@model NhaMeoShop.Models.PhieuNhap

@{
    ViewData["Title"] = "Thêm phiếu nhập";
}

<style>

    body {
        background: #fff8f5;
    }

    .create-container {
        background: white;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .page-title {
        font-size: 34px;
        font-weight: bold;
        color: #6f4e37;
        margin-bottom: 25px;
    }

    .section-title {
        font-size: 24px;
        font-weight: 600;
        color: #5c3d2e;
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #6f4e37;
    }

    .form-control {
        border-radius: 10px;
        padding: 10px;
        border: 1px solid #d6c3b8;
        height: 48px;
    }

    textarea.form-control {
        height: auto;
    }

    .form-control:focus {
        border-color: #6f4e37;
        box-shadow: 0 0 5px rgba(111,78,55,0.3);
    }

    .btn-custom {
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 500;
        transition: 0.3s;
    }

    .btn-create {
        background: #6f4e37;
        color: white;
        border: none;
    }

        .btn-create:hover {
            background: #5c3d2e;
            color: white;
            transform: translateY(-2px);
        }

    .btn-back {
        background: #e9ecef;
        color: #333;
        border: none;
    }

        .btn-back:hover {
            background: #d6d9dc;
            color: black;
        }

    .text-danger {
        font-size: 14px;
    }
</style>

<div class="container mt-4">

    <div class="create-container">

        <div class="page-title">
            <i class="fa-solid fa-file-circle-plus"></i>
            Thêm phiếu nhập
        </div>

        <div class="section-title">
            Thông tin phiếu nhập
        </div>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row">

                <!-- SỐ PHIẾU NHẬP -->
                <div class="col-md-6 mb-3">

                    <label asp-for="SoPN"
                           class="form-label">

                        Số phiếu nhập

                    </label>

                    <input asp-for="SoPN"
                           class="form-control"
                           placeholder="Nhập số phiếu nhập..." />

                    <span asp-validation-for="SoPN"
                          class="text-danger"></span>

                </div>

                <!-- NGÀY NHẬP -->
                <div class="col-md-6 mb-3">

                    <label asp-for="NgayNhap"
                           class="form-label">

                        Ngày nhập

                    </label>

                    <input asp-for="NgayNhap"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="NgayNhap"
                          class="text-danger"></span>

                </div>

                <!-- NGƯỜI GIAO HÀNG -->
                <div class="col-md-6 mb-3">

                    <label asp-for="GiaoHang"
                           class="form-label">

                        Người giao hàng

                    </label>

                    <input asp-for="GiaoHang"
                           class="form-control"
                           placeholder="Nhập tên người giao hàng..." />

                    <span asp-validation-for="GiaoHang"
                          class="text-danger"></span>

                </div>

                <!-- MÃ NHÂN VIÊN -->
                <div class="col-md-6 mb-3">

                    <label asp-for="MaNV"
                           class="form-label">

                        Mã nhân viên

                    </label>

                    <input asp-for="MaNV"
                           class="form-control"
                           placeholder="Nhập mã nhân viên..." />

                    <span asp-validation-for="MaNV"
                          class="text-danger"></span>

                </div>

                <!-- MÃ NHÀ CUNG CẤP -->
                <div class="col-md-6 mb-3">

                    <label asp-for="MaNCC"
                           class="form-label">

                        Mã nhà cung cấp

                    </label>

                    <input asp-for="MaNCC"
                           class="form-control"
                           placeholder="Nhập mã nhà cung cấp..." />

                    <span asp-validation-for="MaNCC"
                          class="text-danger"></span>

                </div>

                <!-- GHI CHÚ -->
                <div class="col-md-12 mb-3">

                    <label asp-for="GhiChuPN"
                           class="form-label">

                        Ghi chú

                    </label>

                    <textarea asp-for="GhiChuPN"
                              rows="4"
                              class="form-control"
                              placeholder="Nhập ghi chú nếu có..."></textarea>

                    <span asp-validation-for="GhiChuPN"
                          class="text-danger"></span>

                </div>

            </div>

            <div class="mt-3">

                <button type="submit"
                        class="btn btn-custom btn-create">

                    <i class="fa-solid fa-plus"></i>
                    Thêm phiếu nhập

                </button>

                <a asp-action="Index"
                   class="btn btn-custom btn-back">

                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}