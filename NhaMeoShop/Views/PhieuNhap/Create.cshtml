@model NhaMeoShop.Models.PhieuNhap

@{
    ViewData["Title"] = "Thêm phiếu nhập";
}

<style>

    body {
        background: #fff8f5;
    }

    .create-container {
        background: white;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .page-title {
        font-size: 34px;
        font-weight: bold;
        color: #6f4e37;
        margin-bottom: 25px;
    }

    .section-title {
        font-size: 24px;
        font-weight: 600;
        color: #5c3d2e;
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #6f4e37;
    }

    .form-control {
        border-radius: 10px;
        padding: 10px;
        border: 1px solid #d6c3b8;
        height: 48px;
    }

    textarea.form-control {
        height: auto;
    }

    .form-control:focus {
        border-color: #6f4e37;
        box-shadow: 0 0 5px rgba(111,78,55,0.3);
    }

    .btn-custom {
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 500;
        transition: 0.3s;
    }

    .btn-create {
        background: #6f4e37;
        color: white;
        border: none;
    }

        .btn-create:hover {
            background: #5c3d2e;
            color: white;
            transform: translateY(-2px);
        }

    .btn-back {
        background: #e9ecef;
        color: #333;
        border: none;
    }

        .btn-back:hover {
            background: #d6d9dc;
            color: black;
        }

    .text-danger {
        font-size: 14px;
    }
</style>

<div class="container mt-4">

    <div class="create-container">

        <div class="page-title">
            <i class="fa-solid fa-file-circle-plus"></i>
            Thêm phiếu nhập
        </div>

        <div class="section-title">
            Thông tin phiếu nhập
        </div>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row">

                <!-- SỐ PHIẾU NHẬP -->
                <div class="col-md-6 mb-3">

                    <label asp-for="SoPN"
                           class="form-label">

                        Số phiếu nhập

                    </label>

                    <input asp-for="SoPN"
                           class="form-control"
                           placeholder="Nhập số phiếu nhập..."
                           value="@ViewBag.SoPN"
                           readonly />

                    <span asp-validation-for="SoPN"
                          class="text-danger"></span>

                </div>

                <!-- NGÀY NHẬP -->
                <div class="col-md-6 mb-3">

                    <label asp-for="NgayNhap"
                           class="form-label">

                        Ngày nhập

                    </label>

                    <input asp-for="NgayNhap"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="NgayNhap"
                          class="text-danger"></span>

                </div>

                <!-- NGƯỜI GIAO HÀNG -->
                <div class="col-md-6 mb-3">

                    <label asp-for="GiaoHang"
                           class="form-label">

                        Người giao hàng

                    </label>

                    <input asp-for="GiaoHang"
                           class="form-control"
                           placeholder="Nhập tên người giao hàng..." />

                    <span asp-validation-for="GiaoHang"
                          class="text-danger"></span>

                </div>

                <!-- MÃ NHÂN VIÊN -->
                <div class="col-md-6 mb-3">

                    <label asp-for="MaNV"
                           class="form-label">

                        Mã nhân viên

                    </label>

                    <input asp-for="MaNV"
                           class="form-control"
                           placeholder="Nhập mã nhân viên..." />

                    <span asp-validation-for="MaNV"
                          class="text-danger"></span>

                </div>

                <!-- MÃ NHÀ CUNG CẤP -->
                <div class="col-md-6 mb-3">

                    <label asp-for="MaNCC"
                           class="form-label">

                        Nhà cung cấp

                    </label>

                    <select asp-for="MaNCC"
                            class="form-control">

                        <option value="">
                            -- Chọn nhà cung cấp --
                        </option>

                        @foreach (var ncc in ViewBag.NCC)
                        {
                            <option value="@ncc.MaNCC">
                                @ncc.TenNCC
                            </option>
                        }

                    </select>

                    <span asp-validation-for="MaNCC"
                          class="text-danger"></span>

                </div>

                <!-- GHI CHÚ -->
                <div class="col-md-12 mb-3">

                    <label asp-for="GhiChuPN"
                           class="form-label">

                        Ghi chú

                    </label>

                    <textarea asp-for="GhiChuPN"
                              rows="4"
                              class="form-control"
                              placeholder="Nhập ghi chú nếu có..."></textarea>

                    <span asp-validation-for="GhiChuPN"
                          class="text-danger"></span>

                </div>

            </div>
            <hr />

            <h4 class="section-title">
                📦 Chi tiết nguyên liệu nhập
            </h4>

            <table class="table table-bordered" id="tableNL">

                <thead class="table-dark">

                    <tr>
                        <th>Mã NL</th>
                        <th>Tên nguyên liệu</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Xóa</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>

                            <select name="MaNL[]"
                                    class="form-control nl-select">

                                @foreach (var nl in ViewBag.NL)
                                {
                                    <option value="@nl.MaNL"
                                            data-ten="@nl.TenNL"
                                            data-gia="@nl.DonGiaNhap">

                                        @nl.MaNL

                                    </option>
                                }

                            </select>

                        </td>

                        <td>

                            <input type="text"
                                   class="form-control ten"
                                   readonly />

                        </td>

                        <td>

                            <input type="number"
                                   name="DGNhap[]"
                                   class="form-control gia"
                                   readonly />

                        </td>

                        <td>

                            <input type="number"
                                   name="SLNhap[]"
                                   class="form-control"
                                   min="1"
                                   required />

                        </td>

                        <td class="text-center">

                            <button type="button"
                                    class="btn btn-danger btn-remove">

                                <i class="fa-solid fa-trash"></i>

                            </button>

                        </td>

                    </tr>

                </tbody>

            </table>

            <button type="button"
                    id="addRow"
                    class="btn btn-success">

                <i class="fa-solid fa-plus"></i>
                Thêm nguyên liệu

            </button>

            <br />
            <br />
            <div class="mt-3">

                <button type="submit"
                        class="btn btn-custom btn-create">

                    <i class="fa-solid fa-plus"></i>
                    Thêm phiếu nhập

                </button>

                <a asp-action="Index"
                   class="btn btn-custom btn-back">

                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại

                </a>

            </div>

        </form>

    </div>

</div>
<script>

    function updateRow(row)
    {
        let select = row.querySelector('.nl-select');
        let ten = row.querySelector('.ten');
        let gia = row.querySelector('.gia');

        let opt = select.options[select.selectedIndex];

        ten.value = opt.getAttribute('data-ten') || '';
        gia.value = opt.getAttribute('data-gia') || 0;
    }

    document.addEventListener("DOMContentLoaded", function ()
    {
        document
            .querySelectorAll('#tableNL tbody tr')
            .forEach(updateRow);
    });

    document.addEventListener('change', function (e)
    {
        if (e.target.classList.contains('nl-select'))
        {
            updateRow(e.target.closest('tr'));
        }
    });

    document.getElementById('addRow').onclick = function ()
    {
        let tbody = document.querySelector('#tableNL tbody');

        let row = tbody.rows[0].cloneNode(true);

        row.querySelectorAll('input').forEach(x =>
        {
            if (!x.classList.contains('gia') &&
                !x.classList.contains('ten'))
            {
                x.value = '';
            }
        });

        tbody.appendChild(row);

        updateRow(row);
    };

    document.addEventListener('click', function (e)
    {
        if (e.target.closest('.btn-remove'))
        {
            let row = e.target.closest('tr');
            let tbody = document.querySelector('#tableNL tbody');

            if (tbody.rows.length > 1)
            {
                row.remove();
            }
        }
    });

</script>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}